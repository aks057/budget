# Copy to .env (never commit .env); the backend dev profile loads it automatically. Values here are local-dev defaults.
DB_NAME=budwiser
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_URL=jdbc:postgresql://localhost:5432/budwiser

# AI assistant (both optional; with neither set the assistant answers 503 and the rest of the app works).
# Groq (primary): https://console.groq.com/keys
GROQ_API_KEY=
# Hugging Face (fallback): https://huggingface.co/settings/tokens  (needs "Inference Providers" permission)
HF_TOKEN=
# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
